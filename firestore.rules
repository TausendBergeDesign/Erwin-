rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: photos
    // Document ID: auto-generated
    // Fields:
    //   - url: string (required) - The image data (base64)
    //   - createdAt: timestamp (required) - When it was uploaded
    //   - userId: string (required) - The UID of the uploader
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /photos/{photoId} {
      // Anyone can see and upload photos for this family event
      allow read: if true;
      allow create: if isValidPhoto(request.resource.data);
      
      // Deletion is restricted to prevent accidental data loss in a public-write setup
      // If needed, we could add a simple password or just disable deletion for now
      allow delete: if false;
      
      // No updates allowed
      allow update: if false;
    }

    function isValidPhoto(data) {
      return data.url is string && 
             data.url.size() < 2000000 && 
             data.createdAt is timestamp;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
